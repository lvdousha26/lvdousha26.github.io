{
  "extends": "astro/tsconfigs/strict",
  "include": ["./.astro/types.d.ts", "./**/*"],
  "compilerOptions": {
    // Basic
    "allowJs": true,
    // 本站是应用而非库(继承 noEmit, 从不产出 d.ts)。
    // 开着会让 astro check 对 astro.config.ts 做声明可移植性检查, 而
    // fontProviders.local() 的类型引用了 astro 内部未公开的 LocalFamilyOptions。
    "declaration": false,
    // Code runs in the DOM
    "lib": ["es2022", "dom", "dom.iterable"],
    // Type Imports
    "verbatimModuleSyntax": true,
    // Others
    "strictNullChecks": true,
    // Paths
    "paths": {
      "@/assets/*": ["./src/assets/*"],
      "@/public/*": ["./public/*"],
      "@/components/*": ["./src/components/*"],
      "@/data/*": ["./src/data/*"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/utils": ["./src/utils/index.ts"],
      "@/utils/*": ["./src/utils/*"],
      "@/plugins/*": ["./src/plugins/*"],
      "@/pages/*": ["./src/pages/*"],
      "@/types": ["./src/types/index.ts"],
      "@/site-config": ["./src/site.config.ts"]
    }
  },
  "exclude": [
    "./node_modules",
    "./**/node_modules/*",
    "./.vscode",
    "./dist",
    "./public/scripts/*",
    "./test/*",
    // 主题作者开发用的源码副本; 站点运行时用的是 node_modules/astro-pure, 不参与本站类型检查
    "./packages"
  ]
}
