---
import type { MarkdownHeading } from 'astro'

import { TOC } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'
import { Comment, PageInfo } from '@/components/comments'

interface Props {
  title: string
  headings?: MarkdownHeading[]
  comment?: boolean
}

const { title, headings, comment: enableComment, ...props } = Astro.props

// 讨论 key 与 URL 形态无关: trailingSlash 为 'never', 但仍防一手带尾斜杠的形态
const term = Astro.url.pathname.replace(/\/+$/, '') || '/'
---

<PageLayout meta={{ title }} {...props}>
  {headings?.length && <TOC headings={headings} slot='sidebar' />}

  <Fragment slot='header'>
    <h1 class='text-2xl font-medium sm:mb-2 sm:text-3xl'>{title}</h1>
    {enableComment && <PageInfo comment class='italic' />}
  </Fragment>

  <slot />

  <slot name='bottom' slot='bottom'>
    {enableComment && <Comment {term} class='mt-3 sm:mt-6' />}
  </slot>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>
