---
// 基于 astro-pure/components/pages/PostPreview.astro:
// 1. 封面图源: 文章自带 heroImage 时用本地图, 否则改用第三方随机图 API(见 @/utils/random-cover);
// 2. 卡片外壳挂在 <li> 上、tag 列表放到 <a> 之外, 对齐参考站 axi404.top 的结构 ——
//    这样调用方传入的 class(如 archives 的 'border-0 bg-transparent py-2')才能作用于卡片本身。
import { Image } from 'astro:assets'
import { type CollectionEntry, render } from 'astro:content'

import { FormattedDate, Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import { Button } from '@/components/user'
import { coverAccent, coverSrc } from '@/utils/random-cover'

type Props = {
  post: CollectionEntry<'blog'>
  detailed?: boolean
  class?: string
}

const { post, detailed = false, class: className } = Astro.props
const { id, data } = post
const { remarkPluginFrontmatter } = await render(post)
const postDate = data.updatedDate ?? data.publishDate

// 只有详细模式的卡片才有封面; 本地头图优先于随机图
const showCover = detailed
const localCover = showCover && data.heroImage ? data.heroImage : null

// 悬浮强调色: 本地头图自带主色就用它, 否则按文章 id 从色板兜底
const accent = localCover?.color ?? coverAccent(id)
---

<li
  class={cn(
    'post-preview group/card flex flex-col relative rounded-2xl border border-border bg-background transition-colors ease-in-out px-5 py-2.5 hover:bg-muted',
    detailed && 'max-sm:px-4 sm:py-5',
    className
  )}
  style={`--preview-highlight:color-mix(in srgb,${accent} 40%,hsl(var(--foreground)/var(--un-text-opacity,1)));
    --preview-highlight-bg:hsl(from ${accent} h s l/20%)`}
>
  <a
    class={cn(
      'group/link w-full flex flex-col transition-all hover:text-primary',
      !detailed && 'sm:flex-row',
      showCover && 'max-md:pt-24'
    )}
    href={`/blog/${id}`}
    data-astro-prefetch
  >
    {
      localCover ? (
        <Image
          alt={localCover.alt || data.title}
          class='cover-image absolute end-0 top-0 z-0 h-2/3 w-full rounded-2xl object-cover opacity-50 transition-opacity duration-300 group-hover/card:opacity-70 md:h-full md:w-3/5'
          loading='eager'
          {...localCover}
        />
      ) : (
        showCover && (
          <img
            alt={data.title}
            class='cover-image absolute end-0 top-0 z-0 h-2/3 w-full rounded-2xl object-cover opacity-50 transition-opacity duration-300 group-hover/card:opacity-70 md:h-full md:w-3/5'
            decoding='async'
            loading='lazy'
            referrerpolicy='no-referrer'
            data-random-cover
            data-seed={id}
            src={coverSrc(id)}
          />
        )
      )
    }

    <FormattedDate class='min-w-[95px] py-1 text-xs' date={postDate} />

    <div class='z-10 flex-grow'>
      {/* title */}
      <div class='flex justify-between'>
        <div class={detailed ? 'font-medium' : undefined}>
          {data.draft && <span class='text-red-500'>(Draft) </span>}
          {data.title}
        </div>
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='preview-redirect my-1 stroke-muted-foreground group-hover/link:stroke-primary'
          ><line
            x1='5'
            y1='12'
            x2='19'
            y2='12'
            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1 group-hover/link:scale-x-100'
          ></line><polyline
            points='12 5 19 12 12 19'
            class='translate-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1'
          ></polyline></svg
        >
      </div>
      {
        detailed && (
          <>
            {/* desc */}
            <p
              class={cn(
                'line-clamp-2 text-sm text-muted-foreground sm:line-clamp-3',
                showCover && 'sm:me-24'
              )}
            >
              {data.description}
            </p>
            <div class='py-2 flex items-center gap-2 text-sm italic leading-4 text-muted-foreground'>
              {/* reading time */}
              <span class='flex items-center gap-1'>
                <Icon name='time' class='size-4' />
                {remarkPluginFrontmatter.minutesRead}
              </span>
              {/* language */}
              {data.language && (
                <span class='flex items-center gap-1'>
                  <Icon name='earth' class='size-4' />
                  {data.language}
                </span>
              )}
            </div>
          </>
        )
      }
    </div>
  </a>

  {
    detailed && data.tags.length > 0 && (
      <ul class='tag-list mt-1 flex flex-wrap gap-2'>
        {data.tags.map((tag: string) => (
          <li>
            <Button as='a' title={tag} href={`/tags/${tag}`} variant='pill' />
          </li>
        ))}
      </ul>
    )
  }

  <style>
    .post-preview {
      --preview-highlight-final: var( --preview-highlight, hsl(var(--primary) / var(--un-text-opacity, 1))
      );
    }
    .post-preview:hover {
      &,
      & .tag-list a {
        background-color: var( --preview-highlight-bg, hsl(var(--muted) / var(--un-bg-opacity, 1))) !important;
      }
      & > a,
      & .tag-list a:hover {
        color: var(--preview-highlight-final) !important;
      }
      & > a .preview-redirect {
        stroke: var(--preview-highlight-final) !important;
      }
    }
    .cover-image {
      -webkit-mask-image: -webkit-linear-gradient(left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
    }

    @media (max-width: 768px) {
      .cover-image {
        -webkit-mask-image: -webkit-linear-gradient(bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      }
    }
  </style>
</li>

<script>
  import { initRandomCovers } from '@/utils/random-cover'

  initRandomCovers()
</script>
