---
// Forked from astro-pure so the pill style can follow Axi-Theme's Button.
// https://github.com/Axi404/Axi-Theme/blob/main/src/components/user/Button.astro
//
// presetMini 不做类冲突消解, cn 也只去重不合并, 所以圆角/内边距/底色必须由 variant 互斥地给出:
// 一旦让调用方用 className 覆盖, 胜负就取决于 UnoCSS 的 CSS 产出顺序。
import type { HTMLTag, Polymorphic } from 'astro/types'

import { cn } from 'astro-pure/utils'

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  as?: string
  title?: string
  href?: string
  variant?: 'button' | 'pill' | 'pill-glass' | 'back' | 'ahead'
  target?: string
  class?: string
}

const { as: Tag = 'a', class: className, title, href, variant = 'button', ...props } = Astro.props

// 玻璃质感胶囊只在 tags 页用, 单独拆一个 variant, 免得首页 Skills 芯片也跟着变透明。
const isGlass = variant === 'pill-glass'
const surface = [
  variant === 'pill' || isGlass ? 'flex rounded-full px-4 py-2' : 'inline-flex rounded-lg px-3 py-2',
  isGlass
    ? 'glass-blur border-gray-200/60 bg-white/80 hover:border-blue-300/80 dark:border-gray-700/60 dark:bg-gray-800/80 dark:hover:border-blue-600/80'
    : 'border-border bg-muted hover:border-foreground/20 hover:bg-muted/80'
].join(' ')
---

<Tag
  class={cn(
    'group relative items-center gap-x-2 border text-sm font-medium text-muted-foreground no-underline transition-all duration-200 hover:text-foreground',
    surface,
    !href && 'cursor-default',
    className
  )}
  href={href}
  data-astro-prefetch
  {...props}
>
  <div class='relative flex items-center gap-x-2'>
    <slot name='before'>
      {
        variant === 'back' && (
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='16'
            height='16'
            viewBox='0 0 24 24'
            fill='none'
            stroke-width='2.5'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='stroke-muted-foreground transition-all duration-200 group-hover:stroke-foreground'
          >
            <line
              x1='19'
              y1='12'
              x2='5'
              y2='12'
              class='translate-x-3 scale-x-0 transition-all duration-200 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100'
            />
            <polyline
              points='12 19 5 12 12 5'
              class='translate-x-1 transition-all duration-200 ease-in-out group-hover:translate-x-0'
            />
          </svg>
        )
      }
    </slot>
    <slot>
      {title && <p class='my-0 transition-colors duration-200'>{title}</p>}
    </slot>
    <slot name='after'>
      {
        variant === 'ahead' && (
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='16'
            height='16'
            viewBox='0 0 24 24'
            fill='none'
            stroke-width='2.5'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='stroke-muted-foreground transition-all duration-200 group-hover:stroke-foreground'
          >
            <line
              x1='5'
              y1='12'
              x2='19'
              y2='12'
              class='translate-x-4 scale-x-0 transition-all duration-200 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100'
            />
            <polyline
              points='12 5 19 12 12 19'
              class='translate-x-0 transition-all duration-200 ease-in-out group-hover:translate-x-1'
            />
          </svg>
        )
      }
    </slot>
  </div>
</Tag>

<style>
  /* presetMini 没有 backdrop-blur-* , 而这两条只声明 backdrop-filter, 不与任何 utility 争同一属性。 */
  .glass-blur {
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
</style>
