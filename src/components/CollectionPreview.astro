---
// 参考 axi404 的 CollectionPreview, 去掉 heroImage 分支:
// 本站没装渐变/backdrop-blur utility, 且四个合集都没有头图, 写了就是永不执行的死分支。
import type { CollectionEntry } from 'astro:content'

import { Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'

type Props = {
  collection: CollectionEntry<'postCollections'>
  /** 侧栏用: 一行标题 + 箭头 */
  minimal?: boolean
  class?: string
}

const { collection, minimal = false, class: className } = Astro.props
const { id, data } = collection
---

{
  minimal ? (
    <li class={className}>
      <a
        class='group flex items-center justify-between gap-x-2 rounded-lg border border-border bg-card p-3 transition-all hover:border-primary/50 hover:bg-muted/50 hover:shadow-sm'
        href={`/collection/${id}`}
        data-astro-prefetch
      >
        <div class='flex flex-col gap-0.5 overflow-hidden'>
          <span class='truncate font-medium text-foreground transition-colors group-hover:text-primary'>
            {data.title}
          </span>
          {data.description && (
            <span class='truncate text-xs text-muted-foreground'>{data.description}</span>
          )}
        </div>
        {/* 主题图标集里没有 chevron, 内联一个朝下的箭头再旋转成朝右 */}
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='shrink-0 -rotate-90 stroke-muted-foreground transition-colors group-hover:stroke-primary'
        >
          <polyline points='6 9 12 15 18 9' />
        </svg>
      </a>
    </li>
  ) : (
    <a
      class={cn(
        'group flex flex-col overflow-hidden rounded-xl border border-border bg-card transition-all hover:border-primary/50 hover:bg-muted/50 hover:shadow-md',
        className
      )}
      href={`/collection/${id}`}
      data-astro-prefetch
    >
      <div class='flex grow flex-col gap-3 p-4'>
        <Icon name='package' class='size-8 text-primary/80' />
        <h2 class='line-clamp-2 text-xl font-medium transition-colors group-hover:text-primary'>
          {data.title}
        </h2>
        {data.description && (
          <p class='line-clamp-3 text-sm text-muted-foreground'>{data.description}</p>
        )}
      </div>

      <div class='flex items-center justify-between p-4 text-sm font-medium text-primary'>
        <span class='text-foreground transition-colors group-hover:text-primary'>
          View Collection
        </span>
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='20'
          height='20'
          viewBox='0 0 24 24'
          fill='none'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='-rotate-90 stroke-muted-foreground transition-colors group-hover:stroke-primary'
        >
          <polyline points='6 9 12 15 18 9' />
        </svg>
      </div>
    </a>
  )
}
